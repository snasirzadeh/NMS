POSTGRES_DB=nms
POSTGRES_USER=nms
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://nms:replace-with-a-long-random-password@postgres:5432/nms
NMS_ENVIRONMENT=development
NMS_CONFIG_CONFIRMATION_SECRET=replace-with-a-long-random-confirmation-secret

NMS_HTTP_PORT=8080

# Absolute host path to the dedicated NMS SSH key directory.
# Example: /home/alice/.ssh/keys
NMS_SSH_KEYS_HOST_DIR=/home/youruser/.ssh/keys

# IdentityFile prefix accepted in pasted OpenSSH configuration.
SSH_IDENTITY_HOST_PREFIX=~/.ssh/keys

# Internal location used by the backend.
SSH_IDENTITY_CONTAINER_PREFIX=/run/ssh-keys
